{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chanote",
  "version": "0.2.0",
  "identifier": "jp.chanote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chanote",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "Lifestyle",
    "shortDescription": "Tea ceremony practice log",
    "longDescription": "chanote records your tea ceremony (chado) practice sessions: temae, roles, shelves, participants, photos, with statistics and export."
  }
}
