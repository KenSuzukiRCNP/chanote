{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "$lib": ["src/lib"], "$lib/*": ["src/lib/*"], "$locales/*": ["locales/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "locales/*.json", "samples/*.json"],
  "extends": "@tsconfig/svelte/tsconfig.json"
}
